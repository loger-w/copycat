+            bars[i] = bb = [i, p, p, p, p, 0.0, 0.0]  # [i, open, high, low, close, vol, outer]
+        bb[2] = max(bb[2], p)
+        bb[3] = min(bb[3], p)
+        bb[4] = p
+        bb[5] += q
+        if a and p >= a:
+            bb[6] += q
+    return [[i, b[1], b[2], b[3], b[4], int(b[5]), int(b[6])] for i, b in sorted(bars.items())]
+
+
+def tsec_text(sec):
