{
  "_doc": [
    "VP(價位別成交量)折法的跨語言 parity fixture(change-spec AD-2)。",
    "後端 `StockDayState._vp` 與前端 `stock-accum.ts::foldVp` 折同一份 ticks,兩邊各自",
    "對 `expected` 斷言 —— 不是其中一邊跑出來回填的,`expected` 全部手算(見下)。",
    "兩份規則各自漂移的失效樣態是「同一檔在單檔頁與卡片上 POC 不同」,兩個數字都看起來",
    "對,沒有任何錯誤訊號。",
    "",
    "規則:剔 p<=0(鎖停市價佇列)、分鐘窗 [540, 810](09:00–13:30 含端點)、",
    "key = 向下貼齊該價位所在段的 tick、cell = [總張, 外盤張, 內盤張](neutral 只進總張)。",
    "",
    "手算對照:",
    "  9990   = 9.99 元(tick 0.01)  : #13 → [9, 9, 0]",
    "  23450  = 23.45 元(tick 0.05) : #10 8外 + #11 2內 + #12 1未分類 → [11, 8, 2]",
    "  99900  = 99.9 元(tick 0.1)   : #4 10未分類 + #5(99.999 snap 下來)4外 → [14, 4, 0]",
    "  100000 = 100 元(tick 0.5)    : #6 6內 + #7(100.499 snap 下來)2外 → [8, 2, 6]",
    "  1005000= 1005 元(tick 5)     : #8 1外 + #9(1009.999 snap 下來)3內 → [4, 1, 3]",
    "剔除:#1 08:59:30(窗前)、#2 13:31:00(窗後)、#3 p=0(市價佇列)"
  ],
  "ticks": [
    { "t": "08:59:30.000", "p": 100000, "q": 5, "side": "outer" },
    { "t": "13:31:00.000", "p": 100000, "q": 7, "side": "inner" },
    { "t": "09:00:00.000", "p": 0, "q": 3, "side": "neutral" },
    { "t": "09:00:00.500", "p": 99900, "q": 10, "side": "neutral" },
    { "t": "09:00:05.000", "p": 99999, "q": 4, "side": "outer" },
    { "t": "09:01:00.000", "p": 100000, "q": 6, "side": "inner" },
    { "t": "09:01:30.000", "p": 100499, "q": 2, "side": "outer" },
    { "t": "10:00:00.000", "p": 1005000, "q": 1, "side": "outer" },
    { "t": "10:00:01.000", "p": 1009999, "q": 3, "side": "inner" },
    { "t": "11:00:00.000", "p": 23456, "q": 8, "side": "outer" },
    { "t": "11:00:10.000", "p": 23450, "q": 2, "side": "inner" },
    { "t": "13:30:00.000", "p": 23499, "q": 1, "side": "neutral" },
    { "t": "09:00:00.000", "p": 9990, "q": 9, "side": "outer" }
  ],
  "expected": {
    "9990": [9, 9, 0],
    "23450": [11, 8, 2],
    "99900": [14, 4, 0],
    "100000": [8, 2, 6],
    "1005000": [4, 1, 3]
  }
}
